rules_version = '2';

// Seis Dynasty Hoops - Firestore security rules (copy kept in the repo for reference;
// the live rules are pasted in Firebase console -> Firestore -> Rules -> Publish).
//
// users/{uid}              profile (name, photo, Sleeper owner id once linked)
// users/{uid}/prefs/{key}  one saved site setting per document (see CLAUDE.md "Cross-device sync")
//
// Only the signed-in person can read or write their own documents. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /prefs/{key} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['v', 't', 'dev'])
          && request.resource.data.t is int
          && (request.resource.data.v == null
              || (request.resource.data.v is string && request.resource.data.v.size() < 500000));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
