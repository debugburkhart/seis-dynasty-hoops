rules_version = '2';

// Seis Dynasty Hoops - Firestore security rules (copy kept in the repo for reference;
// the live rules are pasted in Firebase console -> Firestore -> Rules -> Publish).
// COMMISH_UID below is filled in by Commish -> League office -> Props -> "Copy rules"
// (the commish's own sign-in id); never publish these rules with the placeholder.
//
// users/{uid}              profile (name, photo)
// users/{uid}/prefs/{key}  one saved site setting per document (see CLAUDE.md "Cross-device sync"); the commish may
//                          get (not list, not write) depth chart / tag / note keys of any account (MyGM+)
// claims/{uid}             "I'm this team" requests (Weekly Props), waiting for the commish
// members/{uid}            { owner, t }: account -> Sleeper team, written by the commish only
// props/{season-week}      { lockAt }: the week's first tip-off (created by the first manager to open it)
//   picks/{uid}            { owner, picks: { propId: { o, l } }, t }: hidden from others until lockAt
//   status/{uid}           { owner, n, t }: how many picks, for "who has picked" before the lock
// court/{season}/votes/{caseKey}_{uid}  { k, owner, w, m, t }: Trade Court votes (anyone may read)
// locks/{season_week_pid}  { s, w, pid, o, k, d, p, src, t }: the commish's Dev Dashboard lock picks (anyone may read)
// s9/{owner}               { owner, s: { pid: spot }, c, t }: a team's shared Starting 9 (anyone may read; its manager writes)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCommish() { return signedIn() && request.auth.uid == 'COMMISH_UID'; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    function myTeam() { return get(memberDoc()).data.owner; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /prefs/{key} {
        // MyGM+ (owner, Nov 9 2026): the commish may READ (never write) a manager's depth chart (gm-dc-*), tags and notes;
        // everything else (Assistant Coach what-ifs / lock marks / mode, ...) stays private to that account.
        function commishCanRead() {
          return isCommish() && (key.matches('gm-dc-.*')
            || key in ['gm-tags', 'gm-tag-colors', 'gm-tag-order', 'gm-autotag-order', 'gm-notes']);
        }
        allow get: if (signedIn() && request.auth.uid == uid) || commishCanRead();
        allow list: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['v', 't', 'dev'])
          && request.resource.data.t is int
          && (request.resource.data.v == null
              || (request.resource.data.v is string && request.resource.data.v.size() < 500000));
      }
    }

    match /claims/{uid} {
      allow read: if isCommish() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner', 'name', 'photo', 't'])
        && request.resource.data.owner is string && request.resource.data.owner.size() < 40
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.photo is string && request.resource.data.photo.size() < 1000
        && request.resource.data.t == request.time;
      allow delete: if isCommish() || (signedIn() && request.auth.uid == uid);
    }

    match /members/{uid} {
      allow read: if true;
      allow write: if isCommish();
    }

    match /props/{wk} {
      function lockAt() { return get(/databases/$(database)/documents/props/$(wk)).data.lockAt; }
      function isOpen() { return request.time < lockAt(); }
      function mine(uid) {
        return isMember() && request.auth.uid == uid
          && request.resource.data.owner == myTeam()
          && request.resource.data.t == request.time;
      }

      allow read: if true;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['lockAt'])
        && request.resource.data.lockAt is timestamp
        && request.resource.data.lockAt > request.time
        && request.resource.data.lockAt < request.time + duration.value(14, 'd');
      allow update, delete: if isCommish();

      match /picks/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || !isOpen();
        allow create, update: if mine(uid) && isOpen()
          && request.resource.data.keys().hasOnly(['owner', 'picks', 't'])
          && request.resource.data.picks is map && request.resource.data.picks.size() <= 20;
        allow delete: if false;
      }
      match /status/{uid} {
        allow read: if true;
        allow create, update: if mine(uid) && isOpen()
          && request.resource.data.keys().hasOnly(['owner', 'n', 't'])
          && request.resource.data.n is int;
        allow delete: if false;
      }
    }

    // Trade Court: one vote per manager per trade, changeable forever. Public read.
    match /court/{season}/votes/{id} {
      allow read: if true;
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['k', 'owner', 'w', 'm', 't'])
        && request.resource.data.k is string && request.resource.data.k.size() < 40
        && id == request.resource.data.k + '_' + request.auth.uid
        && request.resource.data.owner == myTeam()
        && request.resource.data.w is string && request.resource.data.w.size() < 40
        && request.resource.data.m in ['h', 's', '']
        && request.resource.data.t == request.time;
      allow delete: if isMember() && id == resource.data.k + '_' + request.auth.uid;
    }

    // Dev Dashboard lock records (owner, Nov 1 2026; assets/locks.js): one doc per season_week_pid. Public read (the
    // nightly job reads them); only the commish writes. src 'you' = his pick (final).
    match /locks/{id} {
      allow read: if true;
      allow create, update: if isCommish()
        && request.resource.data.keys().hasOnly(['s', 'w', 'pid', 'o', 'k', 'd', 'p', 'src', 't'])
        && id == request.resource.data.s + '_' + string(request.resource.data.w) + '_' + request.resource.data.pid
        && request.resource.data.k in ['lock', 'last', 'zero']
        && request.resource.data.src == 'you'
        && request.resource.data.p is number
        && request.resource.data.t == request.time;
      allow delete: if isCommish();
    }

    // Shared Starting 9 (owner, Nov 11 2026): s9/{owner} = { owner, s: { pid: spot }, c: custom?, t }. Anyone may read it (other
    // managers' MyGM views); only that team's linked manager (or the commish) writes it. Nothing else of a depth chart is shared.
    match /s9/{owner} {
      allow read: if true;
      allow create, update: if ((isMember() && myTeam() == owner) || isCommish())
        && request.resource.data.keys().hasOnly(['owner', 's', 'c', 't'])
        && request.resource.data.owner == owner
        && request.resource.data.s is map && request.resource.data.s.size() <= 12
        && request.resource.data.c is bool
        && request.resource.data.t == request.time;
      allow delete: if isCommish();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
